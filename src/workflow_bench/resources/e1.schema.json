{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app_image",
    "n8n_image",
    "runner_image",
    "setup_timeout_sec",
    "submission_timeout_sec",
    "execute_timeout_sec",
    "tool_timeout_sec",
    "control_timeout_sec",
    "drain_timeout_sec",
    "verifier_timeout_sec",
    "cleanup_timeout_sec",
    "total_timeout_sec",
    "cpus",
    "memory_mb",
    "max_calls",
    "tools_port",
    "control_port",
    "broker_port"
  ],
  "properties": {
    "app_image": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9./_-]+@)?sha256:[a-f0-9]{64}$"
    },
    "n8n_image": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9./_-]+@)?sha256:[a-f0-9]{64}$"
    },
    "runner_image": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9./_-]+@)?sha256:[a-f0-9]{64}$"
    },
    "setup_timeout_sec": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "submission_timeout_sec": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "execute_timeout_sec": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "tool_timeout_sec": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "control_timeout_sec": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "drain_timeout_sec": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "verifier_timeout_sec": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "cleanup_timeout_sec": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "total_timeout_sec": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "cpus": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "memory_mb": {
      "type": "integer",
      "minimum": 128,
      "maximum": 8192
    },
    "max_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "tools_port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "control_port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "broker_port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
