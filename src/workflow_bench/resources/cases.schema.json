{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "purpose": {
      "enum": [
        "development",
        "final"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "input",
          "state",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "input": {},
          "state": {},
          "expected": {}
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
