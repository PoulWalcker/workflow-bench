{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "harness",
    "harness_version",
    "backend",
    "model",
    "model_version",
    "methodology",
    "profile",
    "finalized",
    "max_attempts",
    "judge_calls",
    "runtime_llm_calls",
    "attempt",
    "total",
    "credential_cap_usd",
    "retry_policy",
    "enforcement"
  ],
  "properties": {
    "harness": {
      "type": "string",
      "minLength": 1
    },
    "harness_version": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "methodology": {
      "const": "case-pass-v1"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "finalized": {
      "type": "boolean"
    },
    "max_attempts": {
      "const": 2
    },
    "judge_calls": {
      "const": 0
    },
    "runtime_llm_calls": {
      "const": 0
    },
    "attempt": {
      "$ref": "#/$defs/limits"
    },
    "total": {
      "$ref": "#/$defs/limits"
    },
    "credential_cap_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "retry_policy": {
      "const": "no-unknown-retry"
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seconds",
        "tools",
        "model_calls",
        "input_tokens",
        "output_tokens",
        "usd"
      ],
      "properties": {
        "seconds": {
          "type": "string",
          "minLength": 1
        },
        "tools": {
          "type": "string",
          "minLength": 1
        },
        "model_calls": {
          "type": "string",
          "minLength": 1
        },
        "input_tokens": {
          "type": "string",
          "minLength": 1
        },
        "output_tokens": {
          "type": "string",
          "minLength": 1
        },
        "usd": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seconds",
        "tools",
        "model_calls",
        "input_tokens",
        "output_tokens",
        "usd"
      ],
      "properties": {
        "seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tools": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "model_calls": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
