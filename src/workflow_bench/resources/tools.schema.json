{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Bench public tool contract 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "app_image", "profile", "tools"],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "schema": {"type": ["object", "boolean"]}
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "app_image": {"$ref": "#/$defs/text"},
    "profile": {"$ref": "#/$defs/text"},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "schema_version", "description", "arguments_schema", "result_schema", "effect", "limits", "errors", "idempotency", "effect_observation"],
        "properties": {
          "name": {"$ref": "#/$defs/text"},
          "schema_version": {"$ref": "#/$defs/text"},
          "description": {"$ref": "#/$defs/text"},
          "arguments_schema": {"$ref": "#/$defs/schema"},
          "result_schema": {"$ref": "#/$defs/schema"},
          "effect": {"enum": ["read", "write"]},
          "limits": {"type": "object"},
          "errors": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
          "idempotency": {"$ref": "#/$defs/text"},
          "effect_observation": {"$ref": "#/$defs/text"}
        }
      }
    }
  }
}
