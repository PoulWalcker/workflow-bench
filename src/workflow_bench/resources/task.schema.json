{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Bench public Task materials 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["input_schema", "example", "feedback"],
  "properties": {
    "input_schema": {"type": ["object", "boolean"]},
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "state"],
      "properties": {"input": {}, "state": {}}
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_ids", "private_values"],
      "properties": {
        "criterion_ids": {"type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}},
        "private_values": {"const": false}
      }
    }
  }
}
