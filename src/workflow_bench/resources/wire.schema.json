{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "replay_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "profile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "artifact_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profile_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "run_id",
        "attempt_id",
        "replay_id",
        "case_id",
        "profile",
        "artifact_hash",
        "profile_hash"
      ]
    },
    "evidence_v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "before": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "state": {
              "type": "object"
            }
          },
          "required": [
            "revision",
            "state"
          ]
        },
        "after": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "state": {
              "type": "object"
            }
          },
          "required": [
            "revision",
            "state"
          ]
        },
        "events": {
          "type": "array",
          "maxItems": 1200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1
              },
              "call_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "actor": {
                "const": "workflow"
              },
              "profile": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "arguments": {
                "type": "object"
              },
              "stage": {
                "enum": [
                  "accepted",
                  "effect",
                  "response"
                ]
              },
              "details": {
                "type": "object"
              },
              "timestamp": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "seq",
              "call_id",
              "actor",
              "profile",
              "operation",
              "arguments",
              "stage",
              "details",
              "timestamp"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "stage": {
                      "const": "accepted"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "details": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "enum": [
                            "accepted",
                            "rejected"
                          ]
                        },
                        "error": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "error"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "stage": {
                      "const": "effect"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "details": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "enum": [
                            "committed",
                            "no_effect",
                            "unknown"
                          ]
                        },
                        "message_id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "evidence_ref": {
                          "type": "string",
                          "pattern": "^/"
                        }
                      },
                      "required": [
                        "status",
                        "message_id"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "stage": {
                      "const": "response"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "details": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "enum": [
                            "sent",
                            "failed",
                            "unknown"
                          ]
                        },
                        "error": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "error"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "freeze_status": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "pending_call_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "identity",
        "before",
        "after",
        "events",
        "violations",
        "freeze_status",
        "pending_call_ids"
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown",
            "not_applicable"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason_code": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "criterion_id",
        "status",
        "value",
        "reason_code",
        "evidence_refs"
      ]
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scoring_policy": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "case_count",
                "points_per_pass",
                "critical_cap",
                "critical_codes"
              ],
              "properties": {
                "version": {
                  "const": "case-pass-v1"
                },
                "case_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "points_per_pass": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10
                },
                "critical_cap": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "critical_codes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z_]+$"
                  }
                }
              }
            }
          ]
        },
        "success_policy": {
          "enum": [
            null,
            "all-required-v1"
          ]
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "required"
            ]
          }
        }
      },
      "required": [
        "scoring_policy",
        "success_policy",
        "criteria"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "completed",
            "refused",
            "unknown"
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {}
      },
      "required": [
        "status",
        "reason_code",
        "result"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "native_execution_id": {"type": "string", "pattern": "^[0-9]+$"},
        "process_status": {
          "enum": [
            "completed",
            "failed",
            "timed_out",
            "unknown",
            "not_started",
            "cancelled"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "claim": {
          "oneOf": [
            {
              "$ref": "#/$defs/claim"
            },
            {
              "type": "null"
            }
          ]
        },
        "stop_confirmed": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stop_requested": {
          "type": "boolean"
        },
        "initial_process_status": {
          "enum": [
            "completed",
            "failed",
            "timed_out",
            "unknown",
            "not_started",
            "cancelled"
          ]
        }
      },
      "required": [
        "process_status",
        "exit_code",
        "claim",
        "stop_confirmed"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "input": {
          "type": "object"
        },
        "expected": {
          "type": "object"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        }
      },
      "required": [
        "id",
        "input",
        "expected",
        "identity"
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "invalid"
          ]
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_hash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "critical_violations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "identity",
        "score",
        "verdict",
        "completeness",
        "criteria",
        "violations",
        "errors",
        "evidence_hash"
      ]
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "invalid"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "critical_violations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "schema_version": {
          "const": "1.0"
        },
        "purpose": {
          "enum": [
            "development",
            "final"
          ]
        },
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evaluation"
          }
        }
      },
      "required": [
        "score",
        "verdict",
        "completeness",
        "errors",
        "critical_violations",
        "schema_version",
        "purpose",
        "case_ids",
        "cases"
      ]
    },
    "control_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "ui_control"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "control_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "profile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "profile_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "protocol",
        "run_id",
        "control_id",
        "case_id",
        "profile",
        "profile_hash"
      ]
    },
    "evidence_v2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "identity": {
          "$ref": "#/$defs/control_identity"
        },
        "before": {
          "$ref": "#/$defs/evidence_v1/properties/before"
        },
        "after": {
          "$ref": "#/$defs/evidence_v1/properties/after"
        },
        "events": {
          "type": "array",
          "maxItems": 1200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "seq": {
                "$ref": "#/$defs/evidence_v1/properties/events/items/properties/seq"
              },
              "call_id": {
                "$ref": "#/$defs/evidence_v1/properties/events/items/properties/call_id"
              },
              "actor": {
                "const": "control"
              },
              "profile": {
                "$ref": "#/$defs/evidence_v1/properties/events/items/properties/profile"
              },
              "operation": {
                "$ref": "#/$defs/evidence_v1/properties/events/items/properties/operation"
              },
              "arguments": {
                "$ref": "#/$defs/evidence_v1/properties/events/items/properties/arguments"
              },
              "stage": {
                "$ref": "#/$defs/evidence_v1/properties/events/items/properties/stage"
              },
              "details": {
                "type": "object"
              },
              "timestamp": {
                "$ref": "#/$defs/evidence_v1/properties/events/items/properties/timestamp"
              }
            },
            "required": [
              "seq",
              "call_id",
              "actor",
              "profile",
              "operation",
              "arguments",
              "stage",
              "details",
              "timestamp"
            ],
            "allOf": [
              {
                "$ref": "#/$defs/evidence_v1/properties/events/items/allOf/0"
              },
              {
                "if": {
                  "properties": {
                    "stage": {
                      "const": "effect"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "details": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "enum": [
                            "committed",
                            "no_effect",
                            "unknown"
                          ]
                        },
                        "message_id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "evidence_ref": {
                          "type": "string",
                          "pattern": "^/"
                        },
                        "transition": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "from_revision": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "to_revision": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "changes": {
                              "type": "array",
                              "minItems": 1,
                              "maxItems": 256,
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "path": {
                                    "type": "string",
                                    "pattern": "^/"
                                  },
                                  "before": {},
                                  "after": {}
                                },
                                "required": [
                                  "path",
                                  "before",
                                  "after"
                                ]
                              }
                            }
                          },
                          "required": [
                            "from_revision",
                            "to_revision",
                            "changes"
                          ]
                        },
                        "observation": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "revision": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "screen": {
                              "type": "string",
                              "minLength": 1
                            },
                            "query": {
                              "type": "string"
                            },
                            "coverage": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "tree": {
                                  "enum": [
                                    "complete",
                                    "incomplete"
                                  ]
                                },
                                "collection": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "kind": {
                                      "enum": [
                                        "conversations",
                                        "history"
                                      ]
                                    },
                                    "complete": {
                                      "type": "boolean"
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "complete"
                                  ]
                                }
                              },
                              "required": [
                                "tree",
                                "collection"
                              ]
                            },
                            "visible_conversation_ids": {
                              "type": "array",
                              "uniqueItems": true,
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128,
                                "pattern": "^[^\\ud800-\\udfff]*$"
                              }
                            },
                            "visible_message_ids": {
                              "type": "array",
                              "uniqueItems": true,
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128,
                                "pattern": "^[^\\ud800-\\udfff]*$"
                              }
                            }
                          },
                          "required": [
                            "revision",
                            "screen",
                            "query",
                            "coverage",
                            "visible_conversation_ids",
                            "visible_message_ids"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "message_id"
                      ]
                    }
                  }
                }
              },
              {
                "$ref": "#/$defs/evidence_v1/properties/events/items/allOf/2"
              }
            ]
          }
        },
        "violations": {
          "$ref": "#/$defs/evidence_v1/properties/violations"
        },
        "freeze_status": {
          "$ref": "#/$defs/evidence_v1/properties/freeze_status"
        },
        "pending_call_ids": {
          "$ref": "#/$defs/evidence_v1/properties/pending_call_ids"
        }
      },
      "required": [
        "schema_version",
        "identity",
        "before",
        "after",
        "events",
        "violations",
        "freeze_status",
        "pending_call_ids"
      ]
    },
    "evidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/evidence_v1"
        },
        {
          "$ref": "#/$defs/evidence_v2"
        }
      ]
    }
  }
}
