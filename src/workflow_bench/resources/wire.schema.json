{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "replay_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "profile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "artifact_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profile_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "run_id",
        "attempt_id",
        "replay_id",
        "case_id",
        "profile",
        "artifact_hash",
        "profile_hash"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "before": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "state": {
              "type": "object"
            }
          },
          "required": [
            "revision",
            "state"
          ]
        },
        "after": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "state": {
              "type": "object"
            }
          },
          "required": [
            "revision",
            "state"
          ]
        },
        "events": {
          "type": "array",
          "maxItems": 1200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1
              },
              "call_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "actor": {
                "const": "workflow"
              },
              "profile": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "arguments": {
                "type": "object"
              },
              "stage": {
                "enum": [
                  "accepted",
                  "effect",
                  "response"
                ]
              },
              "details": {
                "type": "object"
              },
              "timestamp": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "seq",
              "call_id",
              "actor",
              "profile",
              "operation",
              "arguments",
              "stage",
              "details",
              "timestamp"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "stage": {
                      "const": "accepted"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "details": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "enum": [
                            "accepted",
                            "rejected"
                          ]
                        },
                        "error": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "error"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "stage": {
                      "const": "effect"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "details": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "enum": [
                            "committed",
                            "no_effect",
                            "unknown"
                          ]
                        },
                        "message_id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "evidence_ref": {
                          "type": "string",
                          "pattern": "^/"
                        }
                      },
                      "required": [
                        "status",
                        "message_id"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "stage": {
                      "const": "response"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "details": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "enum": [
                            "sent",
                            "failed",
                            "unknown"
                          ]
                        },
                        "error": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "error"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "freeze_status": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "pending_call_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "identity",
        "before",
        "after",
        "events",
        "violations",
        "freeze_status",
        "pending_call_ids"
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown",
            "not_applicable"
          ]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        }
      },
      "required": [
        "criterion_id",
        "status",
        "reason_code"
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          }
        }
      },
      "required": [
        "verdict",
        "completeness",
        "criteria",
        "errors"
      ]
    }
  }
}
