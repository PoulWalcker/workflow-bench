{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "replay_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "profile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "artifact_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profile_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "run_id",
        "attempt_id",
        "replay_id",
        "case_id",
        "profile",
        "artifact_hash",
        "profile_hash"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "before": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "state": {
              "type": "object"
            }
          },
          "required": [
            "revision",
            "state"
          ]
        },
        "after": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "state": {
              "type": "object"
            }
          },
          "required": [
            "revision",
            "state"
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1
              },
              "call_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "actor": {
                "const": "workflow"
              },
              "profile": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "arguments": {
                "type": "object"
              },
              "stage": {
                "enum": [
                  "accepted",
                  "effect",
                  "response"
                ]
              },
              "details": {
                "type": "object"
              },
              "timestamp": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "seq",
              "call_id",
              "actor",
              "profile",
              "operation",
              "arguments",
              "stage",
              "details",
              "timestamp"
            ]
          }
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "freeze_status": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "pending_call_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "identity",
        "before",
        "after",
        "events",
        "violations",
        "freeze_status",
        "pending_call_ids"
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown",
            "not_applicable"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason_code": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "criterion_id",
        "status",
        "value",
        "reason_code",
        "evidence_refs"
      ]
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scoring_policy": {
          "type": "null"
        },
        "success_policy": {
          "type": "null"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "required"
            ]
          }
        }
      },
      "required": [
        "scoring_policy",
        "success_policy",
        "criteria"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "completed",
            "refused",
            "unknown"
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {}
      },
      "required": [
        "status",
        "reason_code",
        "result"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "process_status": {
          "enum": [
            "completed",
            "failed",
            "timed_out",
            "unknown",
            "not_started",
            "cancelled"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "claim": {
          "oneOf": [
            {
              "$ref": "#/$defs/claim"
            },
            {
              "type": "null"
            }
          ]
        },
        "stop_confirmed": {
          "type": "boolean"
        }
      },
      "required": [
        "process_status",
        "exit_code",
        "claim",
        "stop_confirmed"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "input": {
          "type": "object"
        },
        "expected": {
          "type": "object"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        }
      },
      "required": [
        "id",
        "input",
        "expected",
        "identity"
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "score": {
          "type": "null"
        },
        "verdict": {
          "const": "unknown"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "invalid"
          ]
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_hash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "identity",
        "score",
        "verdict",
        "completeness",
        "criteria",
        "violations",
        "errors",
        "evidence_hash"
      ]
    }
  }
}
