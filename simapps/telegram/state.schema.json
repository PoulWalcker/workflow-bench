{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chats",
    "messages"
  ],
  "properties": {
    "chats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "display_name": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "chat_id",
          "direction",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "chat_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "direction": {
            "enum": [
              "incoming",
              "outgoing"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
