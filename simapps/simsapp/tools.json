{
  "schema_version": "1.0",
  "app_image": "wb-simsapp:wb18a",
  "profile": "simsapp-ui-v1",
  "tools": [
    {
      "name": "ui_observe",
      "schema_version": "1.0",
      "description": "Read the bounded current SimsApp AX tree derived from sanitized Blindly templates. Native roles, hierarchy, missing fields and AX values remain native. ref is a scoped simulator locator; simulation contains explicitly RECONSTRUCTED supported actions, labels, identity hints, direction and draft value. Original attributes/actions not serialized by Blindly remain unknown. Nonannotated nodes have no supported actions. coverage describes the bounded SimsApp collection, not full WhatsApp coverage; truncated retains the capture serializer flag. No business object IDs are exposed.",
      "arguments_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "result_schema": {
        "$defs": {
          "node": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\ud800-\\udfff]*$"
              },
              "role": {
                "enum": [
                  "AXApplication",
                  "AXButton",
                  "AXGroup",
                  "AXHeading",
                  "AXLink",
                  "AXMenu",
                  "AXMenuBar",
                  "AXMenuBarItem",
                  "AXMenuItem",
                  "AXSheet",
                  "AXStaticText",
                  "AXTextArea",
                  "AXWindow"
                ]
              },
              "subrole": {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^[^\\ud800-\\udfff]*$"
              },
              "title": {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^[^\\ud800-\\udfff]*$"
              },
              "description": {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^[^\\ud800-\\udfff]*$"
              },
              "value": {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^[^\\ud800-\\udfff]*$"
              },
              "identifier": {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^[^\\ud800-\\udfff]*$"
              },
              "pid": {
                "const": 0
              },
              "position": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              },
              "size": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "height": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number"
                  }
                },
                "required": [
                  "height",
                  "width"
                ]
              },
              "enabled": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  }
                ]
              },
              "selected": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  }
                ]
              },
              "focused": {
                "type": "boolean"
              },
              "children": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "$ref": "#/$defs/node"
                }
              },
              "simulation": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 128,
                    "pattern": "^[^\\ud800-\\udfff]*$"
                  },
                  "actions": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "activate",
                        "focus",
                        "replace_text"
                      ]
                    }
                  },
                  "identity": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "display_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[^\\ud800-\\udfff]*$"
                      },
                      "identity_hint": {
                        "oneOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128,
                            "pattern": "^[^\\ud800-\\udfff]*$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "display_name",
                      "identity_hint"
                    ]
                  },
                  "direction": {
                    "enum": [
                      "incoming",
                      "outgoing"
                    ]
                  },
                  "value": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 4096,
                        "pattern": "^[^\\ud800-\\udfff]*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "provenance": {
                    "const": "RECONSTRUCTED"
                  }
                },
                "required": [
                  "label",
                  "actions",
                  "provenance"
                ]
              }
            },
            "required": [
              "ref",
              "role"
            ]
          }
        },
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "origin": {
            "const": "control"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\ud800-\\udfff]*$"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "screen": {
            "enum": [
              "chat_list",
              "search",
              "conversation"
            ]
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tree": {
                "enum": [
                  "complete",
                  "incomplete"
                ]
              },
              "collection": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "conversations",
                      "history"
                    ]
                  },
                  "complete": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "complete"
                ]
              }
            },
            "required": [
              "tree",
              "collection"
            ]
          },
          "tree": {
            "$ref": "#/$defs/node"
          },
          "template": {
            "enum": [
              "chat-list",
              "search-focused",
              "results-zero",
              "results-many",
              "conversation"
            ]
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "origin",
          "scope",
          "revision",
          "screen",
          "coverage",
          "tree",
          "template",
          "truncated"
        ]
      },
      "effect": "read",
      "limits": {
        "max_nodes": 640,
        "max_depth": 16
      },
      "errors": [
        "invalid_arguments",
        "stale_locator",
        "target_unavailable",
        "disabled",
        "unsupported_action",
        "not_focused",
        "limit_exceeded",
        "forbidden",
        "observation_incomplete",
        "transport_unknown"
      ],
      "idempotency": "No automatic retries. Repeated focus or identical replacement is a no-op. Send invalidates its locator and clears the draft; re-entering text and sending again creates another message. No text deduplication.",
      "effect_observation": "Fresh ui_observe and protected transition/observation evidence; acknowledgement alone does not prove receipt."
    },
    {
      "name": "ui_action",
      "schema_version": "1.0",
      "description": "Act on a fresh scoped AX reference using simulation.actions: activate, focus or replace_text. Search is the observed AXStaticText/AXSearchField; composer is AXTextArea, with exact draft in simulation.value. Search matches literal case-sensitive contact/hint substrings (256 code points). Composer preserves exact text (4096); newline is text. RECONSTRUCTED activation of the observed Send AXMenuItem atomically appends one outgoing to the active conversation, clears only its draft and preserves focus; empty draft disables it. RECONSTRUCTED Back returns to chat_list and result activation opens the conversation directly. Actual Blindly result press showed a sheet; sheets, message search, scroll, Voice message and other menu actions are unsupported. No business API.",
      "arguments_schema": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "enum": [
                  "activate",
                  "focus"
                ]
              },
              "locator": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scope": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\ud800-\\udfff]*$"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\ud800-\\udfff]*$"
                  }
                },
                "required": [
                  "scope",
                  "revision",
                  "ref"
                ]
              }
            },
            "required": [
              "action",
              "locator"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "replace_text"
              },
              "locator": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scope": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\ud800-\\udfff]*$"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\ud800-\\udfff]*$"
                  }
                },
                "required": [
                  "scope",
                  "revision",
                  "ref"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096,
                "pattern": "^[^\\ud800-\\udfff]*$"
              }
            },
            "required": [
              "action",
              "locator",
              "text"
            ]
          }
        ]
      },
      "result_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "committed",
              "no_effect"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "status",
          "revision"
        ]
      },
      "effect": "write",
      "limits": {},
      "errors": [
        "invalid_arguments",
        "stale_locator",
        "target_unavailable",
        "disabled",
        "unsupported_action",
        "not_focused",
        "limit_exceeded",
        "forbidden",
        "observation_incomplete",
        "transport_unknown"
      ],
      "idempotency": "No automatic retries. Repeated focus or identical replacement is a no-op. Send invalidates its locator and clears the draft; re-entering text and sending again creates another message. No text deduplication.",
      "effect_observation": "Fresh ui_observe and protected transition/observation evidence; acknowledgement alone does not prove receipt."
    }
  ]
}
