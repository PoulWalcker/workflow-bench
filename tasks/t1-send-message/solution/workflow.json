{
  "id": "wb04ManualSend01",
  "name": "T1 manual send control",
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "parameters": {},
      "position": [
        0,
        0
      ]
    },
    {
      "id": "input",
      "name": "BenchInput",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "bench",
              "name": "bench",
              "type": "object",
              "value": "{\"input\":{},\"tools\":{}}"
            }
          ]
        },
        "options": {}
      },
      "position": [
        200,
        0
      ]
    },
    {
      "id": "prepare",
      "name": "Prepare request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const bench = $input.first().json.bench; return [{json: {schema_version: '1.0', arguments: {chat_id: bench.input.chat_id, text: bench.input.text}}}];"
      },
      "position": [
        400,
        0
      ]
    },
    {
      "id": "send",
      "name": "Send message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{$('BenchInput').first().json.bench.tools.base_url + '/tools/send_message'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $('BenchInput').first().json.bench.tools.capability}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json)}}",
        "options": {
          "timeout": 5000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "position": [
        600,
        0
      ]
    },
    {
      "id": "result",
      "name": "BenchResult",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "status",
              "name": "status",
              "type": "string",
              "value": "={{$json.error ? ($json.error.code === 'not_found' ? 'refused' : 'unknown') : 'completed'}}"
            },
            {
              "id": "reason",
              "name": "reason_code",
              "type": "string",
              "value": "={{$json.error ? $json.error.code : ''}}"
            },
            {
              "id": "result",
              "name": "result",
              "type": "object",
              "value": "={{$json.result || null}}"
            }
          ]
        },
        "options": {}
      },
      "position": [
        800,
        0
      ]
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "BenchInput",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "BenchInput": {
      "main": [
        [
          {
            "node": "Prepare request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare request": {
      "main": [
        [
          {
            "node": "Send message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send message": {
      "main": [
        [
          {
            "node": "BenchResult",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
